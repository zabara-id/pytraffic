{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (PYTHONPATH=src)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Python: pytraffic.optimize.problem",
      "type": "debugpy",
      "request": "launch",
      "module": "pytraffic.optimize.problem",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    }
  ]
}
